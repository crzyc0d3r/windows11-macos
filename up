#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ./up [OPTIONS]

Initializes the 100% custom Windows 11 macOS environment (zero third-party apps):
  - Snapshots original macOS Dock, Menu Bar, and Finder state
  - Builds & installs FileExplorer.app and Win11Shell.app into /Applications
  - Applies native hidutil Option <-> Command swap on the built-in keyboard
  - Hides Apple's Dock, auto-hides the macOS top Menu Bar, and suppresses Finder
  - Installs a LaunchAgent for Win11Shell, launches the shell, and verifies liveness

Options:
  --rebuild     Force rebuilding FileExplorer.app and Win11Shell.app
  --dry-run     Print actions without modifying system defaults or apps
  -h, --help    Show this help message and exit
EOF
}

REBUILD=false
DRY_RUN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --rebuild)
            REBUILD=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    TARGET_USER="${SUDO_USER:-$(stat -f '%Su' /dev/console 2>/dev/null || true)}"
    if [[ -z "$TARGET_USER" || "$TARGET_USER" == "root" ]]; then
        echo "Error: Could not resolve non-root desktop user when running under sudo." >&2
        exit 1
    fi
    TARGET_UID="$(id -u "$TARGET_USER")"
    TARGET_GROUP="$(id -gn "$TARGET_USER")"
    TARGET_HOME="$(dscl . -read "/Users/$TARGET_USER" NFSHomeDirectory | awk '{print $2}')"
    run_as_user() {
        /bin/launchctl asuser "$TARGET_UID" /usr/bin/sudo -u "$TARGET_USER" HOME="$TARGET_HOME" "$@"
    }
else
    TARGET_USER="$(id -un)"
    TARGET_UID="$(id -u)"
    TARGET_GROUP="$(id -gn)"
    TARGET_HOME="$HOME"
    run_as_user() {
        "$@"
    }
fi

FE_BUNDLE_ID="com.hackedple.fileexplorer"
SHELL_BUNDLE_ID="com.hackedple.win11shell"
SRC_FE_APP="$ROOT_DIR/build/FileExplorer.app"
SRC_SHELL_APP="$ROOT_DIR/build/Win11Shell.app"
DEST_FE_APP="/Applications/FileExplorer.app"
DEST_SHELL_APP="/Applications/Win11Shell.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

SUPPORT_DIR="$TARGET_HOME/Library/Application Support/HackedpleWin11"
BACKUP_DIR="$SUPPORT_DIR/backup"
LAUNCH_AGENT_DIR="$TARGET_HOME/Library/LaunchAgents"
LAUNCH_AGENT_PLIST="$LAUNCH_AGENT_DIR/${SHELL_BUNDLE_ID}.plist"
LOGS_DIR="$TARGET_HOME/Library/Logs"
LOG_FILE="$LOGS_DIR/Win11Shell.log"

if [[ "$DRY_RUN" == true ]]; then
    echo "[DRY RUN] Target user: $TARGET_USER ($TARGET_UID), home: $TARGET_HOME"
    echo "[DRY RUN] 1. Snapshot original macOS defaults to: $BACKUP_DIR"
    echo "[DRY RUN] 2. Build (rebuild=$REBUILD) and install: $SRC_FE_APP -> $DEST_FE_APP"
    echo "[DRY RUN] 3. Build (rebuild=$REBUILD) and install: $SRC_SHELL_APP -> $DEST_SHELL_APP"
    echo "[DRY RUN] 4. Apply macOS defaults: NSFileViewer=$FE_BUNDLE_ID, QuitMenuItem=true, CreateDesktop=false, Dock hidden, _HIHideMenuBar=true"
    echo "[DRY RUN] 5. Install & bootstrap LaunchAgent: $LAUNCH_AGENT_PLIST (logs: $LOG_FILE)"
    echo "[DRY RUN] 6. Restart Dock/SystemUIServer, quit Finder, ensure single Win11Shell & FileExplorer launch (hidutil swap auto-applies once Input Monitoring is granted)"
    echo "[DRY RUN] 7. Verify Win11ShellApp liveness (1.5s) and print --check-permissions status"
    exit 0
fi

echo "1. Saving one-time macOS backup snapshot..."
mkdir -p "$BACKUP_DIR"
if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    chown -R "$TARGET_USER:$TARGET_GROUP" "$SUPPORT_DIR"
fi

if [[ ! -f "$BACKUP_DIR/snapshot.done" ]]; then
    run_as_user /usr/bin/defaults export com.apple.dock - > "$BACKUP_DIR/com.apple.dock.plist" 2>/dev/null || true
    run_as_user /usr/bin/defaults export com.apple.finder - > "$BACKUP_DIR/com.apple.finder.plist" 2>/dev/null || true

    PREV_HI_HIDE_MENU_BAR="$(run_as_user /usr/bin/defaults read -g _HIHideMenuBar 2>/dev/null || echo "__UNSET__")"
    PREV_NS_FILE_VIEWER="$(run_as_user /usr/bin/defaults read -g NSFileViewer 2>/dev/null || echo "__UNSET__")"
    PREV_FINDER_CREATE_DESKTOP="$(run_as_user /usr/bin/defaults read com.apple.finder CreateDesktop 2>/dev/null || echo "__UNSET__")"
    PREV_FINDER_QUIT_MENU="$(run_as_user /usr/bin/defaults read com.apple.finder QuitMenuItem 2>/dev/null || echo "__UNSET__")"

    cat > "$BACKUP_DIR/global.env" <<EOF
PREV_HI_HIDE_MENU_BAR=${PREV_HI_HIDE_MENU_BAR}
PREV_NS_FILE_VIEWER=${PREV_NS_FILE_VIEWER}
PREV_FINDER_CREATE_DESKTOP=${PREV_FINDER_CREATE_DESKTOP}
PREV_FINDER_QUIT_MENU=${PREV_FINDER_QUIT_MENU}
EOF
    touch "$BACKUP_DIR/snapshot.done"
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        chown -R "$TARGET_USER:$TARGET_GROUP" "$BACKUP_DIR"
    fi
fi

echo "2. Building & installing FileExplorer.app and Win11Shell.app..."
if [[ "$REBUILD" == true || ! -d "$SRC_FE_APP" ]]; then
    run_as_user "$ROOT_DIR/scripts/build-app.sh"
fi
if [[ "$REBUILD" == true || ! -d "$SRC_SHELL_APP" ]]; then
    run_as_user "$ROOT_DIR/scripts/build-win11shell.sh"
fi

rm -rf "$DEST_FE_APP" "$DEST_SHELL_APP"
/usr/bin/ditto "$SRC_FE_APP" "$DEST_FE_APP"
/usr/bin/ditto "$SRC_SHELL_APP" "$DEST_SHELL_APP"
/usr/bin/xattr -dr com.apple.quarantine "$DEST_FE_APP" "$DEST_SHELL_APP" 2>/dev/null || true
chmod -R a+rX "$DEST_FE_APP" "$DEST_SHELL_APP"

run_as_user "$LSREGISTER" -f "$DEST_FE_APP"
run_as_user "$LSREGISTER" -f "$DEST_SHELL_APP"

echo "3. Applying macOS Finder suppression, Dock hiding, and top Menu Bar auto-hide..."
run_as_user /usr/bin/defaults write -g NSFileViewer -string "$FE_BUNDLE_ID"
run_as_user /usr/bin/defaults write com.apple.finder QuitMenuItem -bool true
run_as_user /usr/bin/defaults write com.apple.finder CreateDesktop -bool false
run_as_user /usr/bin/defaults write com.apple.dock autohide -bool true
run_as_user /usr/bin/defaults write com.apple.dock autohide-delay -float 1000
run_as_user /usr/bin/defaults write com.apple.dock autohide-time-modifier -float 0
run_as_user /usr/bin/defaults write com.apple.dock no-bouncing -bool true
run_as_user /usr/bin/defaults write -g _HIHideMenuBar -bool true
run_as_user /usr/bin/osascript -e 'tell application "System Events" to tell dock preferences to set autohide menu bar to true' 2>/dev/null || true

echo "4. Installing LaunchAgent for Win11Shell..."
mkdir -p "$LAUNCH_AGENT_DIR" "$LOGS_DIR"
cat > "$LAUNCH_AGENT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${SHELL_BUNDLE_ID}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${DEST_SHELL_APP}/Contents/MacOS/Win11ShellApp</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>${LOG_FILE}</string>
    <key>StandardErrorPath</key>
    <string>${LOG_FILE}</string>
</dict>
</plist>
EOF
if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    chown "$TARGET_USER:$TARGET_GROUP" "$LAUNCH_AGENT_PLIST"
    chown "$TARGET_USER:$TARGET_GROUP" "$LOGS_DIR"
fi
run_as_user /bin/launchctl bootout "gui/$TARGET_UID/$SHELL_BUNDLE_ID" 2>/dev/null || true
run_as_user /bin/launchctl bootstrap "gui/$TARGET_UID" "$LAUNCH_AGENT_PLIST" 2>/dev/null || true

echo "5. Restarting system UI & launching Windows 11 environment..."
run_as_user /usr/bin/killall Dock 2>/dev/null || true
run_as_user /usr/bin/killall SystemUIServer 2>/dev/null || true
run_as_user /usr/bin/killall Finder 2>/dev/null || true

sleep 0.5
if ! /usr/bin/pgrep -u "$TARGET_UID" -x Win11ShellApp >/dev/null 2>&1; then
    run_as_user /usr/bin/open "$DEST_SHELL_APP"
fi
run_as_user /usr/bin/open "$DEST_FE_APP"

echo "6. Verifying Win11ShellApp liveness..."
sleep 1.5
if ! /usr/bin/pgrep -u "$TARGET_UID" -x Win11ShellApp >/dev/null 2>&1; then
    echo "Error: Win11ShellApp is NOT running after launch!" >&2
    if [[ -f "$LOG_FILE" ]]; then
        echo "--- Tail of $LOG_FILE ---" >&2
        tail -n 40 "$LOG_FILE" >&2 || true
        echo "-------------------------" >&2
    else
        echo "No log file found at $LOG_FILE." >&2
    fi
    exit 1
fi

echo ""
echo "Windows 11 environment is UP!"
echo "  File Explorer: $DEST_FE_APP (NSFileViewer=$FE_BUNDLE_ID)"
echo "  Win11 Shell:   $DEST_SHELL_APP"
echo "  Shell Log:     $LOG_FILE"
echo ""
echo "Permission status (--check-permissions):"
run_as_user "$DEST_SHELL_APP/Contents/MacOS/Win11ShellApp" --check-permissions || true
echo ""
echo "One-time macOS permissions checklist (System Settings -> Privacy & Security):"
echo "  1. Accessibility:    Enable Win11 Shell (required for per-window menu bars, window snapping, and caption buttons)"
echo "  2. Input Monitoring: Enable Win11 Shell (required for Win11 shortcuts, Win key Start Menu tap, and Alt+Tab switcher)"
echo "  3. Screen Recording: Enable Win11 Shell (optional; enables live taskbar hover & Alt+Tab window thumbnails)"
echo ""
echo "Restore original macOS anytime with: $ROOT_DIR/down"
