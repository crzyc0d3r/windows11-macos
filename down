#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ./down [OPTIONS]

Cleanly tears down the custom Windows 11 environment and restores original macOS:
  - Unloads & removes the Win11Shell LaunchAgent
  - Resets built-in keyboard hidutil Option <-> Command mapping
  - Quits Win11ShellApp and FileExplorerApp
  - Restores Dock, top Menu Bar, and Finder defaults from the pre-init backup snapshot
  - Unregisters & removes /Applications/Win11Shell.app and /Applications/FileExplorer.app
  - Removes HackedpleWin11 support files and Win11Shell logs
  - Restarts Dock, SystemUIServer, ControlCenter, and relaunches Finder

Options:
  --keep-apps   Keep /Applications/Win11Shell.app and /Applications/FileExplorer.app
  --dry-run     Print actions without modifying system defaults or apps
  -h, --help    Show this help message and exit
EOF
}

KEEP_APPS=false
DRY_RUN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --keep-apps)
            KEEP_APPS=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    TARGET_USER="${SUDO_USER:-$(stat -f '%Su' /dev/console 2>/dev/null || true)}"
    if [[ -z "$TARGET_USER" || "$TARGET_USER" == "root" ]]; then
        echo "Error: Could not resolve non-root desktop user when running under sudo." >&2
        exit 1
    fi
    TARGET_UID="$(id -u "$TARGET_USER")"
    TARGET_HOME="$(dscl . -read "/Users/$TARGET_USER" NFSHomeDirectory | awk '{print $2}')"
    run_as_user() {
        /bin/launchctl asuser "$TARGET_UID" /usr/bin/sudo -u "$TARGET_USER" HOME="$TARGET_HOME" "$@"
    }
else
    TARGET_USER="$(id -un)"
    TARGET_UID="$(id -u)"
    TARGET_HOME="$HOME"
    run_as_user() {
        "$@"
    }
fi

FE_BUNDLE_ID="com.hackedple.fileexplorer"
SHELL_BUNDLE_ID="com.hackedple.win11shell"
DEST_FE_APP="/Applications/FileExplorer.app"
DEST_SHELL_APP="/Applications/Win11Shell.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

SUPPORT_DIR="$TARGET_HOME/Library/Application Support/HackedpleWin11"
BACKUP_DIR="$SUPPORT_DIR/backup"
LAUNCH_AGENT_PLIST="$TARGET_HOME/Library/LaunchAgents/${SHELL_BUNDLE_ID}.plist"
LOG_FILE="$TARGET_HOME/Library/Logs/Win11Shell.log"
LEGACY_FINDER_BACKUP="$TARGET_HOME/Library/Application Support/FileExplorer/finder-backup.env"

if [[ "$DRY_RUN" == true ]]; then
    echo "[DRY RUN] Target user: $TARGET_USER ($TARGET_UID), home: $TARGET_HOME"
    echo "[DRY RUN] 1. Unload & remove LaunchAgent: $LAUNCH_AGENT_PLIST"
    echo "[DRY RUN] 2. Reset built-in keyboard hidutil mapping: {\"UserKeyMapping\":[]}"
    echo "[DRY RUN] 3. Quit Win11ShellApp and FileExplorerApp"
    echo "[DRY RUN] 4. Restore Dock, Finder, _HIHideMenuBar, NSFileViewer, CreateDesktop, QuitMenuItem from: $BACKUP_DIR"
    echo "[DRY RUN] 5. Unregister & remove /Applications apps (keep_apps=$KEEP_APPS)"
    echo "[DRY RUN] 6. Remove $SUPPORT_DIR, $LOG_FILE, and $LEGACY_FINDER_BACKUP"
    echo "[DRY RUN] 7. Restart Dock, SystemUIServer, ControlCenter and open Finder"
    exit 0
fi

echo "1. Removing Win11Shell LaunchAgent..."
run_as_user /bin/launchctl bootout "gui/$TARGET_UID/$SHELL_BUNDLE_ID" 2>/dev/null || true
rm -f "$LAUNCH_AGENT_PLIST"

echo "2. Resetting built-in keyboard hidutil modifier mapping..."
run_as_user /usr/bin/hidutil property --matching '{"Built-In":true}' --set '{"UserKeyMapping":[]}' >/dev/null 2>&1 || true

echo "3. Stopping Win11ShellApp and FileExplorerApp..."
for bid in "$SHELL_BUNDLE_ID" "$FE_BUNDLE_ID"; do
    run_as_user /usr/bin/osascript -e "tell application id \"$bid\" to quit" 2>/dev/null || true
done
sleep 0.5
/usr/bin/pkill -u "$TARGET_UID" -x Win11ShellApp 2>/dev/null || true
/usr/bin/pkill -u "$TARGET_UID" -x FileExplorerApp 2>/dev/null || true

echo "4. Restoring original macOS defaults..."
PREV_HI_HIDE_MENU_BAR="__UNSET__"
PREV_NS_FILE_VIEWER="__UNSET__"
PREV_FINDER_CREATE_DESKTOP="__UNSET__"
PREV_FINDER_QUIT_MENU="__UNSET__"

if [[ -f "$BACKUP_DIR/global.env" ]]; then
    while IFS='=' read -r key val || [[ -n "$key" ]]; do
        case "$key" in
            PREV_HI_HIDE_MENU_BAR) PREV_HI_HIDE_MENU_BAR="$val" ;;
            PREV_NS_FILE_VIEWER) PREV_NS_FILE_VIEWER="$val" ;;
            PREV_FINDER_CREATE_DESKTOP) PREV_FINDER_CREATE_DESKTOP="$val" ;;
            PREV_FINDER_QUIT_MENU) PREV_FINDER_QUIT_MENU="$val" ;;
        esac
    done < "$BACKUP_DIR/global.env"
fi

# Dock
if [[ -s "$BACKUP_DIR/com.apple.dock.plist" ]]; then
    run_as_user /usr/bin/defaults import com.apple.dock "$BACKUP_DIR/com.apple.dock.plist"
else
    run_as_user /usr/bin/defaults delete com.apple.dock autohide-delay 2>/dev/null || true
    run_as_user /usr/bin/defaults delete com.apple.dock autohide-time-modifier 2>/dev/null || true
    run_as_user /usr/bin/defaults delete com.apple.dock no-bouncing 2>/dev/null || true
fi

# Top Menu Bar
case "$PREV_HI_HIDE_MENU_BAR" in
    1|true|TRUE|YES|yes)
        run_as_user /usr/bin/defaults write -g _HIHideMenuBar -bool true
        run_as_user /usr/bin/osascript -e 'tell application "System Events" to tell dock preferences to set autohide menu bar to true' 2>/dev/null || true
        ;;
    0|false|FALSE|NO|no)
        run_as_user /usr/bin/defaults write -g _HIHideMenuBar -bool false
        run_as_user /usr/bin/osascript -e 'tell application "System Events" to tell dock preferences to set autohide menu bar to false' 2>/dev/null || true
        ;;
    *)
        run_as_user /usr/bin/defaults delete -g _HIHideMenuBar 2>/dev/null || true
        run_as_user /usr/bin/osascript -e 'tell application "System Events" to tell dock preferences to set autohide menu bar to false' 2>/dev/null || true
        ;;
esac

# Finder & NSFileViewer
if [[ -s "$BACKUP_DIR/com.apple.finder.plist" ]]; then
    run_as_user /usr/bin/defaults import com.apple.finder "$BACKUP_DIR/com.apple.finder.plist"
fi

if [[ -n "$PREV_NS_FILE_VIEWER" && "$PREV_NS_FILE_VIEWER" != "__UNSET__" && "$PREV_NS_FILE_VIEWER" != "$FE_BUNDLE_ID" ]]; then
    run_as_user /usr/bin/defaults write -g NSFileViewer -string "$PREV_NS_FILE_VIEWER"
else
    run_as_user /usr/bin/defaults delete -g NSFileViewer 2>/dev/null || true
fi

case "$PREV_FINDER_CREATE_DESKTOP" in
    1|true|TRUE|YES|yes) run_as_user /usr/bin/defaults write com.apple.finder CreateDesktop -bool true ;;
    0|false|FALSE|NO|no) run_as_user /usr/bin/defaults write com.apple.finder CreateDesktop -bool false ;;
    *) run_as_user /usr/bin/defaults delete com.apple.finder CreateDesktop 2>/dev/null || true ;;
esac

case "$PREV_FINDER_QUIT_MENU" in
    1|true|TRUE|YES|yes) run_as_user /usr/bin/defaults write com.apple.finder QuitMenuItem -bool true ;;
    0|false|FALSE|NO|no) run_as_user /usr/bin/defaults write com.apple.finder QuitMenuItem -bool false ;;
    *) run_as_user /usr/bin/defaults delete com.apple.finder QuitMenuItem 2>/dev/null || true ;;
esac

if [[ "$KEEP_APPS" == false ]]; then
    echo "5. Unregistering and removing /Applications apps..."
    for app in "$DEST_SHELL_APP" "$DEST_FE_APP"; do
        if [[ -d "$app" ]]; then
            run_as_user "$LSREGISTER" -u "$app" 2>/dev/null || true
            rm -rf "$app"
        fi
    done
else
    echo "5. Keeping installed apps (--keep-apps)."
fi

echo "6. Cleaning up support files and logs..."
rm -rf "$SUPPORT_DIR"
rm -f "$LOG_FILE" "$LEGACY_FINDER_BACKUP"

echo "7. Restarting Dock, SystemUIServer, ControlCenter, and Finder..."
run_as_user /usr/bin/killall Dock 2>/dev/null || true
run_as_user /usr/bin/killall SystemUIServer 2>/dev/null || true
run_as_user /usr/bin/killall ControlCenter 2>/dev/null || true
run_as_user /usr/bin/killall Finder 2>/dev/null || true
sleep 0.5
run_as_user /usr/bin/open -a Finder

echo ""
echo "Original macOS is restored!"
echo "  Re-enable Windows 11 mode anytime with: $ROOT_DIR/up"
